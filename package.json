{
  "name": "auto-rd-harness",
  "version": "0.1.0",
  "description": "Monorepo for TAPD-driven automated R&D pipeline on DeepSeek Harness",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:m4": "node scripts/test-planner-parser.mjs && node scripts/test-m4-fakes.mjs",
    "test:m5": "node scripts/test-m5-integration.mjs",
    "test:patterns": "node scripts/audit-patterns.mjs",
    "test:executor": "node scripts/test-test-executor.mjs",
    "test:diff": "node scripts/test-git-diff-reader.mjs",
    "test:wtgit": "node scripts/test-worktree-git.mjs",
    "test:probe": "node scripts/test-project-probe.mjs",
    "test:plan": "node scripts/test-plan-builder.mjs",
    "test:clarify": "node scripts/test-clarify.mjs",
    "test:spec": "node scripts/test-spec-builder.mjs",
    "test:design": "node scripts/test-design-loop.mjs",
    "test:storage": "node scripts/test-storage-adapter.mjs",
    "test:ui": "node scripts/test-ui-panel.mjs",
    "test:tools": "node scripts/test-tool-contract.mjs",
    "test:host": "node scripts/test-host-contract.mjs",
    "test:mount": "node scripts/test-mount-smoke.mjs",
    "test:route": "node scripts/test-panel-route.mjs",
    "test:client": "node scripts/test-client-half.mjs",
    "test:reasons": "node scripts/test-reason-codes.mjs",
    "test:install-to-dsh": "node scripts/test-install-to-dsh.mjs",
    "test:stage": "node scripts/test-stage.mjs",
    "test:watch": "node scripts/test-watch-panel.mjs",
    "test:all": "node scripts/test-all.mjs",
    "add-js-extensions": "node scripts/add-js-import-extensions.mjs",
    "install:dsh": "node scripts/install-to-dsh.mjs",
    "uninstall:dsh": "node scripts/install-to-dsh.mjs --uninstall",
    "verify:install": "node scripts/verify-install-dsh.mjs",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20"
  }
}