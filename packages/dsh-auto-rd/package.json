{
  "name": "@yangzhitong/dsh-auto-rd",
  "version": "0.1.0",
  "description": "TAPD-driven automated research & development pipeline for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:personas && npm run copy:client",
    "copy:personas": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','agents','personas');const dst=path.join('lib','agents','personas');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src))if(f.endsWith('.md'))fs.copyFileSync(path.join(src,f),path.join(dst,f));\"",
    "copy:client": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','client','client.js');const dst=path.join('lib','client.js');if(!fs.existsSync(src))throw new Error('missing '+src);fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('copied client bundle -> lib/client.js');\"",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "echo 'Tests live at the repository root: npm run test:all'",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "auto-rd",
    "tapd",
    "gitlab",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-storage-domain": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis":         { "optional": true },
    "@deepseek-ai/dsh-agent":      { "optional": true },
    "@deepseek-ai/dsh-session":    { "optional": true },
    "@deepseek-ai/dsh-tools":      { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.10.0",
    "@deepseek-ai/cordis": "*"
  }
}